@using Microsoft.EntityFrameworkCore
@using Studue.Services
@inject StudueContext studueContext
@inject StudentContext studentContext
@inject AssignmentService assignmentService
@inject NavigationManager Navigation

<PageTitle>@(AssignmentToUpdate != null ? "Edit assignment" : "New assignment")</PageTitle>

<a href="/" class="page-back">&#8592; All assignments</a>

<header class="page-header">
    <div>
        <h1>@(AssignmentToUpdate != null ? "Edit assignment" : "New assignment")</h1>
        <p>@(AssignmentToUpdate != null ? "Update this assignment for " : "Add an assignment for ")@studentContext.Student.Class.</p>
    </div>
</header>

<div class="panel assignment-form-card">
        <form method="post" class="assignment-form-body" @formname="assignment-form" @onsubmit="Submit">
            <AntiforgeryToken/>

            <div class="assignment-form-grid">
                <div class="assignment-form-field">
                    <label for="assignment-module">Module</label>
                    <InputSelect required id="assignment-module" class="assignment-form-control assignment-form-select"
                                 @bind-Value="AssignmentModel!.ModuleCode">
                        <option value="">Choose a module</option>
                        @foreach (var module in Modules)
                        {
                            <option value="@module.Code">@module.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="assignment-form-field">
                    <label for="assignment-date">Due date</label>
                    <InputDate required id="assignment-date"
                               class="assignment-form-control assignment-form-control-compact"
                               min="@Helper.Now().ToString("yyyy-MM-dd")" Type="InputDateType.Date"
                               @bind-Value="AssignmentModel!.DueDate"></InputDate>
                </div>

                <div class="assignment-form-field">
                    <label for="assignment-time">Time (optional)</label>
                    <InputDate id="assignment-time" class="assignment-form-control assignment-form-control-compact"
                               Type="InputDateType.Time" @bind-Value="AssignmentModel!.DueTime"></InputDate>
                </div>
            </div>

            <div class="assignment-form-field">
                <label for="assignment-title">Title</label>
                <InputText required id="assignment-title"
                           class="assignment-form-control assignment-form-control-compact"
                           @bind-Value="AssignmentModel!.Title"/>
            </div>

            <div class="assignment-form-field">
                <label for="assignment-details">Details</label>
                <InputTextArea id="assignment-details" class="assignment-form-control assignment-form-textarea"
                               @bind-Value="AssignmentModel!.Details"/>
            </div>

            <div class="assignment-form-field">
                <span>Type</span>

                <InputRadioGroup @bind-Value="AssignmentModel!.Type">
                    <div class="assignment-form-radio-group">
                        <label class="assignment-form-radio-option assignment-form-radio-option-optional">
                            <InputRadio class="assignment-form-radio" Value="AssignmentType.Optional"/>
                            Optional
                        </label>
                        <label class="assignment-form-radio-option assignment-form-radio-option-mandatory">
                            <InputRadio class="assignment-form-radio" Value="AssignmentType.Mandatory"/>
                            Mandatory
                        </label>
                    </div>
                </InputRadioGroup>
            </div>

            <div class="assignment-form-footer">
                <div class="assignment-form-footer-start">
                    @if (AssignmentToUpdate != null)
                    {
                        var id = $"delete-assignment-{AssignmentToUpdate.Id}";
                        <button onclick="if(!confirm('Do you want to delete the assignment?')) return false;"
                                type="submit" form="@id" class="assignment-form-button assignment-form-button-ghost">
                            <svg viewBox="0 0 24 24" aria-hidden="true"
                                 class="assignment-form-icon assignment-form-icon-trash">
                                <path d="M3 6h18" fill="none" stroke="currentColor" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M8 6V4h8v2" fill="none" stroke="currentColor" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M19 6l-1 14H6L5 6" fill="none" stroke="currentColor" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M10 11v6" fill="none" stroke="currentColor" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M14 11v6" fill="none" stroke="currentColor" stroke-width="2"
                                      stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                            Delete
                        </button>
                    }
                </div>

                <div class="assignment-form-actions">
                    <a href="/" class="assignment-form-close">Cancel</a>
                    <button type="submit"
                            class="assignment-form-button assignment-form-button-primary">@(AssignmentToUpdate != null ? "Save changes" : "Create assignment")</button>
                </div>
            </div>
        </form>

        @if (AssignmentToUpdate != null)
        {
            var id = $"delete-assignment-{AssignmentToUpdate.Id}";
            <form id="@id" method="post" class="assignment-form-delete" @formname=@id
                  onsubmit="@(() => DeleteAssignment(AssignmentToUpdate))">
                <AntiforgeryToken/>
            </form>
        }
</div>


@code {
    [Parameter] [EditorRequired] public Assignment? AssignmentToUpdate { get; set; }

    [Parameter] [EditorRequired] public List<Module> Modules { get; set; }

    [SupplyParameterFromForm(FormName = "assignment-form")]
    public AssignmentModel? AssignmentModel { get; set; }

    async Task DeleteAssignment(Assignment assignmentToUpdate)
    {
        if (studentContext.HasWriteAccess)
        {
            if (!AssignmentService.Attends(assignmentToUpdate, studentContext.Student))
                return;

            assignmentService.Delete(assignmentToUpdate, studentContext.Student);

            await studueContext.SaveChangesAsync();
            Navigation.NavigateTo("/");
        }
    }

    protected override void OnInitialized()
    {
        if (AssignmentToUpdate != null)
        {
            AssignmentModel ??= new AssignmentModel
            {
                ModuleCode = AssignmentToUpdate.ModuleInstance.Module.Code,
                Details = AssignmentToUpdate.Description,
                Title = AssignmentToUpdate.Title,
                Type = AssignmentToUpdate.Mandatory ? AssignmentType.Mandatory : AssignmentType.Optional,
                DueDate = DateOnly.FromDateTime(AssignmentToUpdate.DueDateTime),
                DueTime = TimeOnly.FromDateTime(AssignmentToUpdate.DueDateTime)
            };
        }
        else
        {
            AssignmentModel ??= new();
        }
    }

    private async Task Submit()
    {
        if (AssignmentModel == null)
            return;

        if (AssignmentToUpdate == null && studentContext.HasWriteAccess)
        {
            assignmentService.Create(studentContext.Student, AssignmentModel);
            await studueContext.SaveChangesAsync();

            Navigation.NavigateTo("/");
        }

        if (AssignmentToUpdate != null && studentContext.HasWriteAccess)
        {
            if (!AssignmentService.Attends(AssignmentToUpdate, studentContext.Student))
                return;

            assignmentService.Update(AssignmentToUpdate, studentContext.Student, AssignmentModel);
            await studueContext.SaveChangesAsync();

            Navigation.NavigateTo("/");
        }
    }

}
