<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="icon" href="favicon.png" />

    @* iOS only allows web push for apps added to the home screen, which needs a manifest *@
    <link rel="manifest" href="manifest.json" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Studue" />
    <meta name="theme-color" content="#0061a2" />
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Studue.styles.css"]"/>
    <ImportMap/>
    <HeadOutlet/>
</head>

<body>
<Routes/>
@* <ReconnectModal/> *@
<script src="@Assets["_framework/blazor.web.js"]"></script>

<script>
    console.log("Source code: https://github.com/FlurinBruehwiler/studue")

    function clearQuery(){
        if (window.location.search.length > 0) {
            const url = new URL(window.location.href);
            url.searchParams.delete("write_token");
            url.searchParams.delete("student_id");
            url.searchParams.delete("requestEditLink");
            url.searchParams.delete("message");

            window.history.replaceState({}, '', url);
        }
    }

    // Notification UI state. Kept fully synchronous so the buttons never pop in or out:
    // the browser's real subscription can only be read asynchronously, so this flag is the
    // source of truth instead. If it ever drifts, the next click puts it right - subscribing
    // twice is an upsert, and unsubscribing without a subscription just unregisters.
    const NOTIFICATION_FLAG = "studue-notifications";

    function notificationsSupported() {
        return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;
    }

    function refreshNotificationUi() {
        const enableButton = document.querySelector(".enable-notifications-button");
        const disableButton = document.querySelector(".disable-notifications-button");
        const iosHint = document.querySelector(".ios-notifications-hint");
        if (!enableButton || !disableButton || !iosHint) return;

        const supported = notificationsSupported();
        const subscribed = localStorage.getItem(NOTIFICATION_FLAG) === "on";

        enableButton.style.display = supported && !subscribed ? "inline" : "none";
        disableButton.style.display = supported && subscribed ? "inline" : "none";
        // navigator.standalone is false only in an iOS Safari tab, where push is unavailable
        iosHint.style.display = !supported && navigator.standalone === false ? "block" : "none";
    }

    async function enableNotifications() {
        if (!notificationsSupported()) return;

        const registration = await navigator.serviceWorker.register("/ServiceWorker.js");

        const permission = await Notification.requestPermission();
        if (permission !== "granted") return;

        const subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: document.querySelector(".enable-notifications-button").dataset.vapidKey
        });

        await fetch("/push/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(subscription)
        });

        localStorage.setItem(NOTIFICATION_FLAG, "on");
        refreshNotificationUi();
    }

    async function disableNotifications() {
        localStorage.removeItem(NOTIFICATION_FLAG);
        refreshNotificationUi();

        if (!("serviceWorker" in navigator)) return;

        const registration = await navigator.serviceWorker.getRegistration("/");
        if (!registration) return;

        const subscription = await registration.pushManager.getSubscription();

        if (subscription) {
            // tell the server first, while we still hold the endpoint
            await fetch("/push/unsubscribe", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ endpoint: subscription.endpoint })
            });

            await subscription.unsubscribe();
        }

        await registration.unregister();
    }

    Blazor.addEventListener('enhancedload', clearQuery);
    Blazor.addEventListener('enhancedload', refreshNotificationUi);

    clearQuery();
    refreshNotificationUi();
</script>
</body>

</html>