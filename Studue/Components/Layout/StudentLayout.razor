@layout MainLayout
@using System.Net.Http.Headers
@using System.Web
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using QRCoder
@using Studue.Services
@inject StudentContext StudentContext
@inject NavigationManager Navigation
@inject IOptions<Settings> Settings
@inject IHostEnvironment Environment
@inject ILogger<StudentLayout> Logger
@inject StudueContext StudueContext;
@inherits LayoutComponentBase

<div class="app">
    <header class="app-bar">
        <a href="/" class="app-brand" aria-label="Studue home">
            <img src="@Assets["studue-mark.svg"]" alt="" class="app-brand-mark"/>
            <span>Studue</span>
        </a>

        <nav class="app-nav" aria-label="Primary">
            <a href="/" class="app-nav-link @(IsScheduleRoute || IsSettingsRoute ? null : "is-active")">Home</a>
            <a href="/schedule" class="app-nav-link @(IsScheduleRoute ? "is-active" : null)">Schedule</a>
        </nav>

        <div class="app-account">
            @if (StudentContext.Student == null)
            {
                <a href="/login" class="app-button app-button-primary">Sign in</a>
            }
            else
            {
                <a href="/settings" class="app-account-name @(IsSettingsRoute ? "is-active" : null)">@StudentContext.Student.StudentId</a>

                @if (StudentContext.Student.IsAdmin && StudentContext.HasWriteAccess)
                {
                    <a href="/admin" class="app-button app-button-secondary">Admin</a>
                }

                @if (!StudentContext.HasWriteAccess)
                {
                    if (disableAuthenticateButton)
                    {
                        <a href="/?requestEditLink=true" class="app-button app-button-primary disable" aria-disabled="true" tabindex="-1">Authenticate to edit</a>
                    }
                    else
                    {
                        <a href="/?requestEditLink=true" class="app-button app-button-primary" >Authenticate to edit</a>
                    }

                }
            }
        </div>
    </header>

    @if (_notice != null)
    {
        <div class="app-notice" role="status">
            <p>@_notice</p>
            <a href="/" class="app-notice-dismiss" aria-label="Dismiss">&times;</a>
        </div>
    }

    @foreach (var banner in _banners)
    {
        @* no role="status": the promo is there on first paint, so announcing it as a live
           status update would interrupt a screen reader on every single page load *@
        <div class="app-promo" id="banner-@banner.Id">
            <p>
                @banner.Message

                @if (!string.IsNullOrWhiteSpace(banner.LinkUrl))
                {
                    <a href="@banner.LinkUrl">@(string.IsNullOrWhiteSpace(banner.LinkText) ? "Learn more" : banner.LinkText)</a>
                }
            </p>

            <button type="button" class="app-promo-dismiss" aria-label="Dismiss"
                    onclick="dismissBanner(@banner.Id)">&times;</button>
        </div>
    }

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    //the sign-in link is about the session, not about any one page, so it lives with the chrome
    [Parameter]
    [SupplyParameterFromQuery(Name = "requestEditLink")]
    public bool RequestEditLink { get; set; }

    private MarkupString? _notice;
    private bool disableAuthenticateButton;
    private List<Banner> _banners = [];

    private bool IsScheduleRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("schedule", StringComparison.OrdinalIgnoreCase);

    private bool IsSettingsRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("settings", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (StudentContext.Student == null)
            return;

        var now = Helper.Now();
        var today = now.Date;

        _banners = await StudueContext.Banners
            .Where(x => x.Enabled
                        && (x.StartsAt == null || x.StartsAt <= now)
                        && (x.EndsAt == null || x.EndsAt >= today)
                        && !x.DismissedByStudents.Contains(StudentContext.Student))
            .OrderBy(x => x.Id)
            .ToListAsync();

        disableAuthenticateButton = (DateTime.UtcNow - StudentContext.Student.LastAuthenticationMailSend).TotalMinutes < 1;

        if (!RequestEditLink || disableAuthenticateButton)
            return;

        var verifyLink = new Uri(new Uri(Settings.Value.FrontendUrl), $"?write_token={HttpUtility.UrlEncode(StudentContext.Student.WriteToken)}&student_id={StudentContext.Student.StudentId}");

        var qrCodeGenerator = new PayloadGenerator.Url(verifyLink.ToString());
        using var qrCode = QRCodeGenerator.GenerateQrCode(qrCodeGenerator);
        using var pongRenderer = new PngByteQRCode(qrCode);
        var qrCodeImage = pongRenderer.GetGraphic(20);

        if (Environment.IsDevelopment())
        {
            Console.WriteLine(verifyLink);
        }

        var qrCodeContent = (new ByteArrayContent(qrCodeImage)
            {
                Headers = { ContentType = new MediaTypeHeaderValue("image/png") }
            },
            "inline",
            "magic-link-qr.png");

        var email = $"{StudentContext.Student.StudentId}@students.zhaw.ch";

        Logger.LogInformation("Sending edit link to {email}", email);

        //todo, we would probably want to permanently have this status message, even when the user reloads, but that is for the future

        _notice = await StudentContext.SendMail(email, "Your Studue sign-in link", verifyLink.ToString(), string.Format(Helper.VerifyEmailHtml, StudentContext.Student.StudentId, verifyLink), [ qrCodeContent ])
            ? new MarkupString($"We sent a sign-in link to {email} — check <a href=\"https://outlook.office.com\">outlook.office.com</a>.")
            : new MarkupString("We were unable to send you an email, try again later.");

        disableAuthenticateButton = true;
        StudentContext.Student.LastAuthenticationMailSend = DateTime.UtcNow;
        await StudueContext.SaveChangesAsync();
    }
}
