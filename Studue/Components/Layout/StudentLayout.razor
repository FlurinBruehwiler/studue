@layout MainLayout
@using Studue.Services
@inject StudentContext StudentContext
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<div class="app">
    <header class="app-bar">
        <a href="/" class="app-brand" aria-label="Studue home">
            <img src="/studue-mark.svg" alt="" class="app-brand-mark"/>
            <span>Studue</span>
        </a>

        <nav class="app-nav" aria-label="Primary">
            <a href="/" class="app-nav-link @(IsScheduleRoute ? null : "is-active")">Home</a>
            <a href="/schedule" class="app-nav-link @(IsScheduleRoute ? "is-active" : null)">Schedule</a>
        </nav>

        <div class="app-account">
            <span class="app-account-name">@StudentContext.Student.StudentId</span>

            @if (StudentContext.Student.IsAdmin && StudentContext.HasWriteAccess)
            {
                <a href="/admin" class="app-button app-button-secondary">Admin</a>
            }

            @if (!StudentContext.HasWriteAccess)
            {
                <a href="/?requestEditLink=true" class="app-button app-button-primary">Authenticate to edit</a>
            }

            <button type="button" class="app-button app-button-secondary" onclick="logout()">Logout</button>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<script>
function logout() {
    document.cookie = 'student_id=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
    document.cookie = 'write_token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
    window.location.href = "/";
}
</script>

@code {
    private bool IsScheduleRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("schedule", StringComparison.OrdinalIgnoreCase);
}
