@layout Layout.MainLayout
@using Studue.Services
@inject StudentContext StudentContext
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<div class="student-layout">
    <div class="student-layout-shell">
        <header class="student-layout-header">
            <a href="/" class="student-layout-brand" aria-label="Go to home page">
                <img src="/studue-mark.svg" alt="Studue logo" class="student-layout-brand-mark"/>

                <section class="student-layout-hero">
                    <span class="student-layout-eyebrow">@HeaderEyebrow</span>
                    <h1>@HeaderTitle</h1>
                    <p>@HeaderDescription</p>
                </section>
            </a>

            <div class="student-layout-actions">
                <span class="student-layout-chip">@StudentContext.Student.StudentId</span>
                <span class="student-layout-chip student-layout-chip-outline">@StudentContext.Student.Class</span>

                <a href="/" class="student-layout-button @(IsScheduleRoute ? "student-layout-button-secondary" : "student-layout-button-primary")">
                    Home
                </a>
                <a href="/schedule" class="student-layout-button @(IsScheduleRoute ? "student-layout-button-primary" : "student-layout-button-secondary")">
                    Schedule
                </a>

                @if (StudentContext.Student.IsAdmin && StudentContext.HasWriteAccess)
                {
                    <a href="/admin" class="student-layout-button student-layout-button-secondary">Admin</a>
                }

                <button type="button" class="student-layout-button student-layout-button-secondary" onclick="logout()">Logout</button>
            </div>
        </header>

        <div class="student-layout-body">
            @Body
        </div>
    </div>
</div>

<script>
function logout() {
    document.cookie = 'student_id=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
    document.cookie = 'write_token=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
    window.location.href = "/";
}
</script>

@code {
    private bool IsScheduleRoute => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("schedule", StringComparison.OrdinalIgnoreCase);

    private string HeaderEyebrow => IsScheduleRoute ? "Weekly timetable" : "Assignment overview";

    private string HeaderTitle => IsScheduleRoute ? "Schedule" : "Assignments";

    private string HeaderDescription => IsScheduleRoute
        ? $"Current semester lessons for {StudentContext.Student.Class}."
        : $"Shared assignment calendar for {StudentContext.Student.Class}.";
}
