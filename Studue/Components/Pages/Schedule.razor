@page "/schedule"
@layout Layout.StudentLayout

@using Studue.Services

@attribute [StudentRequired]

@inject StudentContext StudentContext
@inject SemesterService SemesterService

<PageTitle>Schedule | Studue</PageTitle>

<header class="page-header">
    <div>
        <h1>Schedule</h1>
        <p>Current semester lessons for @StudentContext.Student.Class.</p>
    </div>

    @if (_currentWeekNumber is { } weekNumber)
    {
        <span class="schedule-week-badge">Week @weekNumber</span>
    }
</header>

<div class="schedule-page">
    <ScheduleComponent ScheduleEntries="_scheduleEntries" ModuleAccents="_moduleAccents"></ScheduleComponent>
</div>

@code {

    private List<ScheduleEntry> _scheduleEntries = [];
    private IReadOnlyDictionary<string, string> _moduleAccents = new Dictionary<string, string>();
    private int? _currentWeekNumber;

    protected override async Task OnInitializedAsync()
    {
        _scheduleEntries = await StudentContext.GetScheduleEntriesForStudent(StudentContext.Student.StudentId);
        _moduleAccents = await StudentContext.GetModuleAccents();

        //outside the lecture weeks (e.g. exam session) there is no week number, so no badge
        var weeks = await SemesterService.GetWeeks(Helper.GetCurrentSemester()) ?? [];
        var today = DateOnly.FromDateTime(Helper.Now().Date);
        var index = weeks.FindIndex(x => x.Start <= today && today <= x.End);
        _currentWeekNumber = index >= 0 ? index + 1 : null;
    }
}
