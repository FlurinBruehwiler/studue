@page "/map"
@attribute [StudentOptional]
@layout Layout.StudentLayout
@using System.Text.Json
@using Studue.Services
@inject StudentContext StudentContext
@inject BuildingIndex BuildingIndex

<PageTitle>@PageTitleText</PageTitle>

@* discovered while the HTML is still parsing, so these load alongside each other
   instead of one after the next *@
<HeadContent>
    <PageMeta Title="@PageTitleText" Description="@MetaDescription"/>

    <link rel="preload" as="script" href="@_leafletJs"/>
    @* a real stylesheet, not a preload: injecting it from js put it outside the head that
       enhanced navigation diffs against, so it was dropped when returning to this page *@
    <link rel="stylesheet" href="@_leafletCss"/>
    @if (_campusUrl != null)
    {
        <link rel="preload" as="fetch" type="application/json" crossorigin="anonymous" href="@_campusUrl"/>
    }
</HeadContent>

<script type="application/json" id="map-urls">@((MarkupString)_assetUrls)</script>

<div class="map-page" data-building="@_highlight" data-campus="@_campusId">
    <div id="campus-map" class="map-surface"></div>

    <h1 id="map-campus" class="map-campus">@_campusName</h1>

    <details class="map-picker" id="map-picker">
        <summary class="map-picker-toggle">
            <span id="map-current">@(_highlight ?? _campusName ?? "Select a building")</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="map-picker-caret">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </summary>

        <div class="map-picker-body">
            <input id="building-search" class="map-search-input" type="search" autocomplete="off"
                   placeholder="Search a building or campus" oninput="filterBuildings(this.value)"/>

            <ul class="map-results" id="map-results">
                @foreach (var campus in BuildingIndex.CampusIds.OrderBy(x => BuildingIndex.NameForCampus(x), StringComparer.Ordinal))
                {
                    <li>
                        <a class="map-result @(campus == _campusId && _highlight == null ? "is-active" : null)"
                           href="@($"/map?campus={campus}")">
                            <span>@BuildingIndex.NameForCampus(campus)</span>
                        </a>
                    </li>
                }

                @foreach (var building in BuildingIndex.CodesFor(_campusId ?? "").Concat(BuildingIndex.Codes.Where(x => BuildingIndex.CampusFor(x) != _campusId)))
                {
                    <li>
                        <a class="map-result @(building == _highlight ? "is-active" : null)" href="@($"/map?building={building}")">
                            <span>@building</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </details>

    <p id="map-message" class="map-message" style="display: none" role="status"></p>

    <p class="map-attribution">Map data &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors</p>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "building")]
    public string? Building { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "campus")]
    public string? Campus { get; set; }

    private string PageTitleText => _highlight != null
        ? $"ZHAW {_highlight} – {_campusName}, {City} | Studue"
        : $"ZHAW {_campusName}, {City} – building map | Studue";

    private static readonly Dictionary<string, string> CityByCampus = new()
    {
        ["campus-technikumstrasse"] = "Winterthur",
        ["campus-st-georgen-platz"] = "Winterthur",
        ["campus-stadt-mitte"] = "Winterthur",
        ["campus-zentrum-lagerstrasse"] = "Zürich",
        ["campus-zentrum-toni-areal"] = "Zürich",
        ["campus-gruental"] = "Wädenswil",
        ["campus-reidbach"] = "Wädenswil",
    };

    private string City => _campusId != null && CityByCampus.TryGetValue(_campusId, out var city) ? city : "Switzerland";

    private string MetaDescription => _highlight != null
        ? $"Where is ZHAW building {_highlight}? Find it on {_campusName} in {City} – building map and Lageplan with every building on campus."
        : $"ZHAW {_campusName} in {City}: building map and Lageplan showing every building and its code.";

    private string? _campusId;
    private string? _campusName;
    private string? _highlight;

    private string _leafletJs = "";
    private string _leafletCss = "";
    private string? _campusUrl;
    private string _assetUrls = "{}";

    protected override async Task OnInitializedAsync()
    {
        _campusId = await ResolveCampus();
        _campusName = BuildingIndex.NameForCampus(_campusId);
        BuildAssetUrls();
    }

    private async Task<string?> ResolveCampus()
    {
        if (Campus != null)
            return Campus;

        if (Building != null)
        {
            _highlight = Building.ToUpperInvariant();
            return BuildingIndex.CampusFor(_highlight) ?? BuildingIndex.DefaultCampus;
        }

        if (StudentContext.Student == null)
            return BuildingIndex.DefaultCampus;

        // opening the map cold, the useful default is wherever you are headed next
        var entries = await StudentContext.GetScheduleEntriesForStudent(StudentContext.Student.StudentId);

        return BuildingIndex.CampusFor(NextLessonBuilding(entries)) ?? BuildingIndex.DefaultCampus;
    }

    // the fingerprinted url is the one served as immutable, and it is only known here.
    // Every campus is listed, because the picker switches between them without a reload.
    private void BuildAssetUrls()
    {
        _leafletJs = AssetUrl("lib/leaflet/leaflet.js");
        _leafletCss = AssetUrl("lib/leaflet/leaflet.css");

        var campus = BuildingIndex.CampusIds
            .OrderBy(x => x, StringComparer.Ordinal)
            .ToDictionary(x => x, x => AssetUrl($"maps/{x}.json"));

        if (_campusId != null)
            campus.TryGetValue(_campusId, out _campusUrl);

        _assetUrls = JsonSerializer
            .Serialize(new { leafletJs = _leafletJs, leafletCss = _leafletCss, campus })
            .Replace("<", "<");
    }

    private string AssetUrl(string path)
    {
        try
        {
            return Assets[path];
        }
        catch (Exception)
        {
            // an asset the build does not know about still has to load, just uncached
            return $"/{path}";
        }
    }

    private static string? NextLessonBuilding(List<ScheduleEntry> entries)
    {
        var now = Helper.Now();
        var today = ((int)now.DayOfWeek + 6) % 7;   //the schedule counts Monday as 0
        var timeOfDay = TimeOnly.FromDateTime(now);

        return entries
            .Where(x => Helper.BuildingCode(x.Room) != null)
            .Select(x => new
            {
                Entry = x,
                //days until it comes round again, this week or next
                Days = (x.Weekday - today + 7) % 7 == 0 && x.StartTime <= timeOfDay
                    ? 7
                    : (x.Weekday - today + 7) % 7,
            })
            .OrderBy(x => x.Days)
            .ThenBy(x => x.Entry.StartTime)
            .Select(x => Helper.BuildingCode(x.Entry.Room))
            .FirstOrDefault();
    }
}
