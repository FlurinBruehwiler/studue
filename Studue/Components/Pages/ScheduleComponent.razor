@if (ScheduleEntries.Count == 0)
{
    <section class="schedule-board schedule-board-empty">
        <div>
            <h2>No timetable yet</h2>
            <p>Your lessons appear here once your schedule has been fetched from stundenplan.zhaw.ch</p>
        </div>
    </section>
}
else
{
    <section class="panel schedule-board">
        <div class="schedule-table-wrap">
            <div class="schedule-week" role="grid" aria-label="Weekly schedule">
                <div class="schedule-time-column">
                    <div class="schedule-corner-cell" role="columnheader">Time</div>

                    @foreach (var lesson in _lessons)
                    {
                        <div class="schedule-time-cell" role="rowheader">
                            <span>@lesson.Start.ToString("HH:mm")</span>
                            <span>@lesson.End.ToString("HH:mm")</span>
                        </div>
                    }
                </div>

                @foreach (var (weekdayIndex, weekday) in _weekdays.Index())
                {
                    var entries = ScheduleEntries.Where(x => x.Weekday == weekdayIndex).OrderBy(x => x.StartTime).ToList();
                    var collapsible = entries.Count == 0 ? "true" : null;

                    <div class="schedule-day-column" data-collapsible="@collapsible">
                        <div class="schedule-day-cell" role="columnheader">@weekday</div>

                        @foreach (var (lessonIndex, _) in _lessons.Index())
                        {
                            <div class="schedule-slot-cell" style="grid-row: @(lessonIndex + 2);" aria-hidden="true"></div>
                        }

                        @foreach (var entry in entries)
                        {
                            <article class="schedule-entry-card"
                                     style="grid-row: @(GetLessonIndex(entry.StartTime) + 2) / span @entry.Duration;"
                                     aria-label="@entry.Module.Name in @entry.Room with @entry.Teacher">
                                <span class="schedule-entry-code">@entry.Module.Code</span>
                                <strong class="schedule-entry-title">@entry.Module.Name</strong>

                                <div class="schedule-entry-meta">
                                    <span>@entry.Room</span>
                                    <span>@entry.Teacher</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    [EditorRequired]
    public List<ScheduleEntry> ScheduleEntries { get; set; }

    private static readonly List<Lesson> _lessons = new[] { "08:15", "09:05", "10:15", "11:05", "13:00", "13:50", "14:50", "15:40", "16:40", "17:30", "18:40", "19:30", "20:25", "21:15" }
        .Select(x => new Lesson(TimeOnly.Parse(x), TimeOnly.Parse(x).AddMinutes(45))).ToList();

    private static readonly string[] _weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];


    record struct Lesson(TimeOnly Start, TimeOnly End);

    private int GetLessonIndex(TimeOnly startTime)
    {
        return _lessons.FindIndex(x => x.Start == startTime);
    }
}
