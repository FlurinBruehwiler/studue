@page "/settings"
@attribute [StudentRequired]
@layout Layout.StudentLayout
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using Studue.MCP
@using Studue.Services
@inject StudueContext StudueContext
@inject StudentContext StudentContext
@inject IOptions<Settings> Settings

<PageTitle>Settings | Studue</PageTitle>

<header class="page-header">
    <div>
        <h1>Settings</h1>
        <p>Signed in as @StudentContext.Student.StudentId, @StudentContext.Student.Class.</p>
    </div>

    <div>
        @if (StudentContext.HasWriteAccess)
        {
            <button type="button" class="app-button app-button-secondary" onclick="rotateToken()">Log out on all devices</button>
        }
        <button type="button" class="app-button app-button-secondary" onclick="logout()">Log out</button>
    </div>
</header>

<section class="panel settings-section">
    <h2>Notifications</h2>

    <p class="settings-note">
        Studue can send a push notification one day and one hour before an assignment is due.
        Being able to choose your own reminder times is planned.
    </p>

    <div class="settings-actions">
        <button type="button" class="app-button app-button-primary enable-notifications-button" style="display: none"
                data-vapid-key="@_vapidPublicKey" onclick="enableNotifications()">Enable notifications</button>

        <button type="button" class="app-button app-button-secondary disable-notifications-button" style="display: none"
                onclick="disableNotifications()">Disable notifications</button>
    </div>

    <p class="notifications-status text-status" style="display: none" role="status"></p>

    <p class="ios-notifications-hint" style="display: none">
        To get notifications on your iPhone, tap Share and then <strong>Add to Home Screen</strong>. Open Studue from there and this option will appear.
    </p>
</section>

@if (StudentContext.HasWriteAccess)
{
    <section class="panel settings-section">
        <h2>Reload schedule</h2>

        <p class="settings-note">
            Reload the schedule from stundenplan.zhaw.ch
        </p>

        <div class="settings-actions">
            <button type="button" class="app-button app-button-primary reload-schedule-button" onclick="reloadSchedule()">Reload</button>
        </div>

        <p class="reload-schedule-status text-status" style="display: none" role="status"></p>
    </section>

    <section class="panel settings-section">
        <h2>Configure MCP</h2>

        <p class="settings-note">
            Configure the Studue MCP for your AI Assistant. The token is hidden below, but the copy
            includes it. Treat it like a password, and use "Log out on all devices" if it leaks.
        </p>

        <pre class="mcp-config">@_maskedMcpConfig</pre>

        <div class="settings-actions">
            <button type="button" class="app-button app-button-primary copy-mcp-config-button"
                    data-config="@_mcpConfig" onclick="copyMcpConfig()">Copy configuration</button>
        </div>

        <p class="mcp-config-status text-status" style="display: none" role="status"></p>
    </section>
}

<section class="panel settings-section">
    <h2>About</h2>

    <p class="settings-note">
        Feature requests / bug reports can be posted as issues on GitHub.
    </p>

    <div class="settings-actions">
        <a class="app-button app-button-secondary" href="https://github.com/FlurinBruehwiler/studue"
           target="_blank" rel="noopener">Studue on GitHub</a>
    </div>
</section>

@code {
    private string? _vapidPublicKey;
    private string? _mcpConfig;
    private string? _maskedMcpConfig;

    protected override async Task OnInitializedAsync()
    {
        _vapidPublicKey = (await StudueContext.Configs.FirstAsync(x => x.Id == "VapidKey.Public")).Data;

        if (!StudentContext.HasWriteAccess)
            return;

        _mcpConfig = BuildMcpConfig(StudentContext.Student.WriteToken);
        // the token is only ever copied, never read off the screen, so nothing is lost by
        // keeping it out of sight of whoever is standing behind you
        _maskedMcpConfig = BuildMcpConfig("******");
    }

    private string BuildMcpConfig(string writeToken)
    {
        var student = StudentContext.Student;

        var config = new
        {
            mcpServers = new
            {
                studue = new
                {
                    type = "http",
                    url = new Uri(new Uri(Settings.Value.FrontendUrl), StudueMcp.RoutePrefix).ToString(),
                    headers = new Dictionary<string, string>
                    {
                        ["Authorization"] = $"Bearer {writeToken}",
                        ["X-Student-Id"] = student.StudentId,
                    },
                },
            },
        };

        // the token is base64, so the default encoder would turn every '+' into '+':
        // valid json, but unreadable for anyone comparing it against their client config.
        // Razor escapes the value on render, so relaxed escaping stays safe here.
        return JsonSerializer.Serialize(
            config,
            new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            }
        );
    }
}
