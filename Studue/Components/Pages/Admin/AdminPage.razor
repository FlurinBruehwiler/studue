@attribute [Authorize]
@attribute [StudentRequired]
@page "/admin"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject DatabaseContext DatabaseContext;

<section>
    <h2>Overview</h2>

    <div>
        <p>Students: <b>@_studentCount</b> </p>
        <p>Modules: <b>@_moduleCount</b></p>
        <p>Module instances: <b>@_moduleInstanceCount</b></p>
        <p>Assignments: <b>@_assignmentCount</b></p>
    </div>

    <div>
        <p>Active user in the last 24 hours: <b>@_activeUsersInTheLast24Hours</b> </p>
        <p>Active user in the last Week: <b>@_activeUsersInTheLastWeek</b> </p>
    </div>

    <div>
        <p>Edit leaderboard this semester</p>

        <table>
            <thead>
            <th>Student</th>
            <th>Edit count</th>
            </thead>
            <tbody>
            @foreach (var entry in _leaderboard)
            {
                <tr>
                    <td>@entry.student</td>
                    <td>@entry.editcount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private int _studentCount;
    private int _moduleCount;
    private int _moduleInstanceCount;
    private int _assignmentCount;

    private int _activeUsersInTheLast24Hours;
    private int _activeUsersInTheLastWeek;
    private List<(string student, int editcount)> _leaderboard = [];

    protected override async Task OnParametersSetAsync()
    {
        _studentCount = await DatabaseContext.Students.CountAsync();
        _moduleCount = await DatabaseContext.Modules.CountAsync();
        _moduleInstanceCount = await DatabaseContext.ModuleInstances.CountAsync();
        _assignmentCount = await DatabaseContext.Assignements.CountAsync();

        var dayCutoff = DateTime.UtcNow.AddHours(-24);
        _activeUsersInTheLast24Hours = await DatabaseContext.Students.Where(x => x.LastAccess > dayCutoff).CountAsync();
        var weekCutoff = DateTime.Now.AddDays(-7);
        _activeUsersInTheLastWeek = await DatabaseContext.Students.Where(x => x.LastAccess > weekCutoff).CountAsync();

        var semesterStart = Helper.GetCurrentSemesterStart();
        var leaderboard = await DatabaseContext.EditLog
            .Where(x => x.DateTime > semesterStart)
            .GroupBy(x => x.Student)
            .Select(x => new { Student = x.Key.StudentId, EditCount = x.Count() })
            .OrderByDescending(x => x.EditCount)
            .ToListAsync();

        _leaderboard = leaderboard.Select(x => (x.Student, x.EditCount)).ToList();
    }
}
